# Elasticsearch
ELASTICSEARCH_URL=http://your-es-host:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME
ELASTICSEARCH_INDEX_PATTERN=logs-*

# APM
APM_INDEX_PATTERN=apm-*

# Prometheus
PROMETHEUS_URL=http://your-prometheus:9090

# Kubernetes (leave KUBECONFIG_PATH empty for in-cluster)
KUBECONFIG_PATH=
# K8S namespaces to monitor (JSON array format)
K8S_NAMESPACES=["default","production"]

# Alerting
ALERT_CHECK_INTERVAL_SECONDS=30
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Multiple emails: ["email1@example.com","email2@example.com"]
ALERT_EMAIL_TO=[]
ALERT_WEBHOOK_URL=

# App
# CORS origins (JSON array format - add multiple origins: ["http://localhost:3000","https://example.com"])
CORS_ORIGINS=["http://localhost:3000"]
POLL_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=5

# Authentication
# Generate secret: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_ENABLED=true
AUTH_SECRET=
# Generate API key: python3 -c "import secrets; print(secrets.token_hex(32))"
# For multiple keys, use: ["key1","key2"]
API_KEYS=[]
# Token lifetime in seconds (default: 86400 = 24 hours)
AUTH_TOKEN_TTL_SECONDS=900
# Allowed webhook hosts (empty = allow all; set to ["host1","host2"] to restrict)
ALLOWED_WEBHOOK_HOSTS=[]

# AI / LLM (Claude API for Triage Card generation)
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096

# SLO Reporting
SLO_REPORT_ENABLED=true
SLO_REPORT_HOUR=9
SLO_REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# Environment (development/staging/production)
ENVIRONMENT=development

# Internal Services (for dependency health checks)
# Format: JSON object with service names and URLs
INTERNAL_SERVICES={"auth-service":"http://auth-service:8080","user-service":"http://user-service:8080","notification-service":"http://notification-service:8080","postgres-primary":"http://postgres-primary:5432","redis-cache":"http://redis-cache:6379"}

# External API endpoints
EXTERNAL_ENDPOINTS={"stripe":"https://api.stripe.com/v1"}

# Slack Approval Webhook
SLACK_APPROVAL_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# Teams Approval Webhook
TEAMS_WEBHOOK_URL=
TEAMS_SIGNING_SECRET=

# Allowed Webhook IPs (optional, for additional security)
# Leave empty to allow all IPs, or specify: ["1.2.3.4","5.6.7.8"]
ALLOWED_WEBHOOK_IPS=[]
